{
  "name": "shiwen-dsh-desktop",
  "version": "0.1.15",
  "private": true,
  "type": "module",
  "description": "拾文桌面客户端，以 DSH 为底座、以插件集成个人知识与创作功能",
  "license": "MIT",
  "workspaces": [
    "plugins/*"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/start-native.mjs",
    "dev": "node scripts/start-native.mjs",
    "test": "node --test tests/*.test.mjs",
    "desktop:install": "node scripts/install-desktop-entry.mjs",
    "prepare:linux": "node scripts/prepare-linux.mjs",
    "package:linux": "node scripts/package-linux.mjs",
    "package:windows": "node scripts/package-windows.mjs",
    "upstream:prepare": "node scripts/setup-upstream.mjs",
    "upstream:check": "node scripts/setup-upstream.mjs --check",
    "check:source": "node scripts/check-source.mjs",
    "start:web": "node scripts/start-web.mjs",
    "package:plugin": "node scripts/package-plugin.mjs",
    "server:prepare": "node scripts/prepare-server.mjs",
    "server:start": "node scripts/server.mjs start",
    "server:stop": "node scripts/server.mjs stop",
    "server:status": "node scripts/server.mjs status",
    "server:url": "node scripts/server.mjs url",
    "mobile:contracts": "node scripts/mobile-contracts.mjs",
    "test:mobile": "node --test --test-isolation=none tests/mobile-*.test.mjs",
    "check:mobile-kotlin": "node scripts/check-mobile-kotlin.mjs",
    "android:doctor": "npm --prefix android run doctor",
    "android:build:web": "npm --prefix android run build"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.2.2-alpha.3",
    "@deepseek-ai/schemastery": "~3.18.6-alpha.2",
    "@modelcontextprotocol/server": "2.2.0",
    "bonjour-service": "^1.4.4",
    "diff": "^8.0.0",
    "js-yaml": "^4.3.2",
    "markdown-it": "^15.0.3",
    "qrcode": "^1.5.4",
    "selfsigned": "^5.5.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.2.0",
    "electron": "45.2.2",
    "electron-builder": "26.18.0",
    "esbuild": "0.25.12"
  },
  "engines": {
    "node": ">=24.9.0"
  },
  "homepage": "https://github.com/wyf929597870/shiwen-dsh",
  "repository": {
    "type": "git",
    "url": "https://github.com/wyf929597870/shiwen-dsh.git"
  },
  "bugs": {
    "url": "https://github.com/wyf929597870/shiwen-dsh/issues"
  }
}
